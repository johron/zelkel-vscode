{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Zelkel",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#llvmBlock"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#typeNames"
		},
		{
			"include": "#functionNames"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.zelkel",
					"match": "//.*$"
				},
				{
					"name": "comment.block.zelkel",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"llvmBlock": {
			"begin": "(#llvm)\\s*(\\{)",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.directive.llvm.zelkel"
				},
				"2": {
					"name": "punctuation.section.block.begin.zelkel"
				}
			},
			"end": "(\\})",
			"endCaptures": {
				"1": {
					"name": "punctuation.section.block.end.zelkel"
				}
			},
			"contentName": "meta.embedded.block.llvm.zelkel",
			"patterns": [
				{
					"name": "keyword.control.llvm.instruction.zelkel",
					"match": "\\b(alloca|store|load|call|ret|br|phi|getelementptr|bitcast|ptrtoint|inttoptr|malloc|free|align)\\b"
				},
				{
					"name": "support.type.llvm.integer.zelkel",
					"match": "\\bi[0-9]+\\b"
				},
				{
					"name": "variable.other.register.llvm.zelkel",
					"match": "%[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#strings"
				}
			]
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.zelkel",
				"match": "\\b(package|require|self|val|var|const|if|else|while|for|return)\\b|\\b(?:class!?|struct!?|fn!?)(?![A-Za-z0-9_])"
			}, {
				"name": "constant.language.zelkel",
				"match": "\\b(true|false|null)\\b"
			}, {
				"name": "support.type.primitive.zelkel",
				"match": "\\b(void|Self|String)\\b"
			}]
		},
		"declarations": {
			"patterns": [
				{
					"name": "entity.name.namespace.zelkel",
					"match": "(?<=\\bpackage\\s)[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*"
				},
				{
					"name": "entity.name.namespace.import.zelkel",
					"match": "(?<=\\brequire\\s)[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*"
				},
				{
					"name": "entity.name.type.class.zelkel",
					"match": "(?<=\\bclass!?\\s)[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"name": "entity.name.type.struct.zelkel",
					"match": "(?<=\\bstruct!?\\s)[A-Za-z_][A-Za-z0-9_]*"
				}
			]
		},
		"attributes": {
			"patterns": [
				{
					"name": "storage.modifier.attribute.zelkel",
					"match": ":[A-Za-z_][A-Za-z0-9_]*"
				}
			]
		},
		"typeNames": {
			"patterns": [
				{
					"name": "storage.type.zelkel",
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
				},
				{
					"name": "storage.type.generic.parameter.zelkel",
					"match": "(?<=<)\\s*[A-Z][A-Za-z0-9_]*\\s*(?=>|,)"
				}
			]
		},
		"functionNames": {
			"patterns": [
				{
					"name": "entity.name.function.zelkel",
					"match": "(?<=\\bfn!?\\s)[A-Za-z_][A-Za-z0-9_]*"
				},
				{
					"name": "entity.name.function.call.zelkel",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.integer.zelkel",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.arrow.zelkel",
					"match": "->"
				},
				{
					"name": "keyword.operator.reference.zelkel",
					"match": "&"
				},
				{
					"name": "keyword.operator.assignment.zelkel",
					"match": "="
				},
				{
					"name": "keyword.operator.access.zelkel",
					"match": "(::|\\.)"
				},
				{
					"name": "keyword.operator.zelkel",
					"match": "[+\\-*/%!]"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.colon.zelkel",
					"match": ":"
				},
				{
					"name": "punctuation.separator.comma.zelkel",
					"match": ","
				},
				{
					"name": "punctuation.definition.group.zelkel",
					"match": "[(){}<>]"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.zelkel",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.zelkel",
					"match": "\\\\."
				}
			]
		}
	},
	"scopeName": "source.zelkel"
}