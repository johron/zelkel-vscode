{
  "name": "zelkel",
  "displayName": "Zelkel",
  "description": "Zelkel language support",
  "version": "0.1.4",
  "icon": "./icons/kel-bg.png",
  "publisher": "JohanRong",
  "repository": {
    "type": "git",
    "url": "https://github.com/johron/zelkel-vscode"
  },
  "engines": {
    "vscode": "^1.119.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "zelkel",
      "aliases": ["Zelkel", "zelkel"],
      "extensions": [".zk"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./icons/kel.png",
        "dark": "./icons/kel.png"
      }
    }],
    "grammars": [{
      "language": "zelkel",
      "scopeName": "source.zelkel",
      "path": "./syntaxes/zelkel.tmLanguage.json"
    }]
  }
}
